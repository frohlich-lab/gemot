# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/
.DS_Store

# AMICI-compiled model output
*_amici/
amici_models/
petab_mcp_amici/

# Provenance/version store written next to a problem
.petab_mcp/

# Per-run scratch copy, persistent AMICI build cache, and data-regeneration build dir
# written by every example runner (examples/<name>/…)
examples/*/work/
examples/*/.amici_build/
examples/*/.gen_build/

# Per-run metrics log appended by collect_metrics.py (generated; grows every run —
# the durable history belongs to a CI/nightly job, not to dev commits)
examples/_harness/metrics_history.csv

# Local Weights & Biases run artifacts (run.py --wandb writes ./wandb/; synced to the cloud)
wandb/

# Run-explorer per-run archive: bundles the web UI (examples/explore_ui.py) reads; written
# by each harness run's archive_run(). Generated — grows every run, not for dev commits.
examples/_runs_archive/

# Slurm runner (slurm/): the conda env, per-task scratch copies, job logs, collected
# per-sweep results, and the shared Phoenix collector's on-disk data. All generated.
envs/
.slurm_scratch/
slurm/logs/
slurm/runs/
slurm/phoenix_data/

# Local Phoenix working dir for the example harness (examples/_harness/__init__.py) --
# ephemeral trace data for locally-launched Phoenix apps / clients. Generated.
.phoenix/

# Trace-review generated digests (slurm/trace_review/): reusable scripts + FINDINGS.md are
# tracked; the per-scenario digests, extraction logs, and job-id files are generated.
slurm/trace_review/provenance/
slurm/trace_review/llm/
slurm/trace_review/*.log
slurm/trace_review/*.jobid

# Zero-shot benchmark PEtab problems are materialized from the pinned Benchmark-Models-PEtab
# collection by `python examples/setup.py` — NOT vendored. Only reference.json (the committed
# BIC answer key) is tracked. Synthetic examples (enzyme_kinetics/predator_prey/repressilator)
# simulate their own data and stay vendored, so they are not listed here.
examples/perelson/problem/*
!examples/perelson/problem/reference.json
examples/blasi/problem/*
!examples/blasi/problem/reference.json
examples/rahman/problem/*
!examples/rahman/problem/reference.json
examples/crauste/problem/*
!examples/crauste/problem/reference.json
examples/oliveira/problem/*
!examples/oliveira/problem/reference.json
examples/armistead/problem/*
!examples/armistead/problem/reference.json
examples/fiedler/problem/*
!examples/fiedler/problem/reference.json
examples/sneyd/problem/*
!examples/sneyd/problem/reference.json
examples/bruno/problem/*
!examples/bruno/problem/reference.json
examples/boehm/problem/*
!examples/boehm/problem/reference.json
examples/brannmark/problem/*
!examples/brannmark/problem/reference.json
examples/schwen/problem/*
!examples/schwen/problem/reference.json
examples/fujita/problem/*
!examples/fujita/problem/reference.json
slurm/trace_review/crauste_deepdive/
slurm/trace_review/biolit_deepdive/
