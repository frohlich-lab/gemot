# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/
.DS_Store

# AMICI-compiled model output
*_amici/
amici_models/
petab_mcp_amici/

# Provenance/version store written next to a problem
.petab_mcp/

# Per-run scratch copy, persistent AMICI build cache, and data-regeneration build dir
# written by every example runner (examples/<name>/…)
examples/*/work/
examples/*/.amici_build/
examples/*/.gen_build/

# Per-run metrics log appended by collect_metrics.py (generated; grows every run —
# the durable history belongs to a CI/nightly job, not to dev commits)
examples/metrics_history.csv

# Local Weights & Biases run artifacts (run.py --wandb writes ./wandb/; synced to the cloud)
wandb/

# Run-explorer per-run archive: bundles the web UI (examples/explore_ui.py) reads; written
# by each harness run's archive_run(). Generated — grows every run, not for dev commits.
examples/_runs_archive/

# Slurm runner (slurm/): the conda env, per-task scratch copies, job logs, collected
# per-sweep results, the shared Phoenix collector's on-disk data, and the explorer service's
# published endpoint + live-run symlink root. All generated.
envs/
.slurm_scratch/
slurm/logs/
slurm/runs/
slurm/phoenix_data/
slurm/explorer_data/
slurm/refit_logs/

# Local Phoenix working dir for the example harness (petab_harness/paths.py) --
# ephemeral trace data for locally-launched Phoenix apps / clients. Generated.
.phoenix/

# Trace-review generated digests (slurm/trace_review/): reusable scripts + FINDINGS.md are
# tracked; the per-scenario digests, extraction logs, and job-id files are generated.
slurm/trace_review/provenance/
slurm/trace_review/llm/
slurm/trace_review/*.log
slurm/trace_review/*.jobid
# Ad-hoc per-investigation working sets under trace_review/. Ignore the GENERATED artifacts by
# extension, not the directories: these dirs mix generated output with hand-written scripts
# (refit_exp/ holds refit.py + run_refit.sh next to its refit_*.out logs), and a directory-level
# ignore silently refuses `git add` on the scripts -- the one kind of loss git never warns about.
slurm/trace_review/*_deepdive/*.md
slurm/trace_review/*_deepdive/*.out
slurm/trace_review/*_deepdive/*.json
slurm/trace_review/*_fullsweep/*.md
slurm/trace_review/*_fullsweep/*.out
slurm/trace_review/*_fullsweep/*.json
slurm/trace_review/refit_exp/*.out
# A/B working sets (ab_*/, and the pulled span tables any investigation writes). These dirs were
# not covered by the two patterns above and a run manifest reached the index because of it --
# 41 kB rebuildable in one pass from slurm/runs/results/*/result.json. Same rule as the rest:
# artifacts by extension, so the pull scripts beside them stay addable.
slurm/trace_review/ab_*/*.json
slurm/trace_review/*/*.parquet

# Zero-shot benchmark PEtab problems are materialized from the pinned Benchmark-Models-PEtab
# collection by `python examples/setup.py` — NOT vendored. Only reference.json (the committed
# BIC answer key) is tracked. Synthetic examples (enzyme_kinetics/predator_prey/repressilator)
# simulate their own data and stay vendored, so they are not listed here.
examples/perelson/problem/*
!examples/perelson/problem/reference.json
examples/blasi/problem/*
!examples/blasi/problem/reference.json
examples/rahman/problem/*
!examples/rahman/problem/reference.json
examples/crauste/problem/*
!examples/crauste/problem/reference.json
examples/oliveira/problem/*
!examples/oliveira/problem/reference.json
examples/armistead/problem/*
!examples/armistead/problem/reference.json
examples/fiedler/problem/*
!examples/fiedler/problem/reference.json
examples/sneyd/problem/*
!examples/sneyd/problem/reference.json
examples/bruno/problem/*
!examples/bruno/problem/reference.json
examples/boehm/problem/*
!examples/boehm/problem/reference.json
examples/brannmark/problem/*
!examples/brannmark/problem/reference.json
examples/schwen/problem/*
!examples/schwen/problem/reference.json
examples/fujita/problem/*
!examples/fujita/problem/reference.json
examples/alkan/problem/*
!examples/alkan/problem/reference.json
examples/bachmann/problem/*
!examples/bachmann/problem/reference.json
examples/isensee/problem/*
!examples/isensee/problem/reference.json
examples/lucarelli/problem/*
!examples/lucarelli/problem/reference.json
examples/raimundez/problem/*
!examples/raimundez/problem/reference.json
slurm/trace_review/crauste_deepdive/
slurm/trace_review/biolit_deepdive/
# Refit / solver-probe RESULTS (reusable scripts alongside them are tracked): per-start records
# from slurm/refit_references.sh, the atol probes, and the jitter ladders. Regenerable, and a
# single sweep is megabytes of JSON.
slurm/refit_runs/
slurm/atol_out/
slurm/jitter_out_*/
slurm/bio_cache/

# Session analysis dirs under slurm/ (added 2026-08-19, tightened 2026-08-20). A `git add slurm/`
# in ae53121 swept 543 untracked files into the branch — 237 of them under these three dirs, plus
# four Slurm logs of 5.4M lines that had to be stripped from history before GitHub would accept
# the push (>100 MB per-file limit). These are per-investigation scratch: scripts written for one
# question, their digests, and their job logs. Ignoring the dirs wholesale rather than by
# extension, because the earlier extension list still let .csv/.jsonl through.
#
# The 26 files here that predate ae53121 stay TRACKED — .gitignore does not untrack anything
# already committed, which is the behaviour we want: they were committed deliberately.
slurm/_bench/
slurm/trace_review/
slurm/_*.log

# The exception: the refit_probes SCRIPTS set the per-example fit caps and are cited as if tracked
# (examples/setup.py, slurm/refit_references.sh, examples/BENCHMARK_NOTES.md), so they come in
# while everything they produce — logs/, probe_*/, out_*/, jitter_out/, and every .json of
# recorded starts — stays out. Data is never committed; it is regenerated by these scripts.
# Spelled `dir/*` rather than `dir/`: git cannot re-include anything beneath an excluded DIRECTORY.
slurm/refit_probes/*
!slurm/refit_probes/*.py
!slurm/refit_probes/*.sh

# Per-investigation probes: one question each, written and run once. They belong in
# slurm/_probes/, which is ignored wholesale — 56 had accumulated loose at the top of slurm/ and
# `git status` was unreadable. Only the DIRECTORY is ignored, deliberately: should a probe ever
# need tracking, it has to stay `git add`-able, and an extension rule here would silently refuse
# it -- the one kind of loss git never warns about.
slurm/_probes/

# Sweep figures rendered at the repo root by slurm/sweep_heatmap.py -o.
sweep_*.png
