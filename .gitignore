# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/
.DS_Store

# AMICI-compiled model output
*_amici/
amici_models/
petab_mcp_amici/

# Provenance/version store written next to a problem
.petab_mcp/

# Per-run scratch copy, persistent AMICI build cache, and data-regeneration build dir
# written by every example runner (examples/<name>/…)
examples/*/work/
examples/*/.amici_build/
examples/*/.gen_build/

# Per-run metrics log appended by collect_metrics.py (generated; grows every run —
# the durable history belongs to a CI/nightly job, not to dev commits)
examples/_harness/metrics_history.csv

# Local Weights & Biases run artifacts (run.py --wandb writes ./wandb/; synced to the cloud)
wandb/

# Run-explorer per-run archive: bundles the web UI (examples/explore_ui.py) reads; written
# by each harness run's archive_run(). Generated — grows every run, not for dev commits.
examples/_runs_archive/

# Slurm runner (slurm/): the conda env, per-task scratch copies, job logs, collected
# per-sweep results, and the shared Phoenix collector's on-disk data. All generated.
envs/
.slurm_scratch/
slurm/logs/
slurm/runs/
slurm/phoenix_data/

# Local Phoenix working dir for the example harness (examples/_harness/__init__.py) --
# ephemeral trace data for locally-launched Phoenix apps / clients. Generated.
.phoenix/

# Trace-review generated digests (slurm/trace_review/): reusable scripts + FINDINGS.md are
# tracked; the per-scenario digests, extraction logs, and job-id files are generated.
slurm/trace_review/provenance/
slurm/trace_review/llm/
slurm/trace_review/*.log
slurm/trace_review/*.jobid
